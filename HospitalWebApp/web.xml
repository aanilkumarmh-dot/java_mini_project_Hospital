<?xml version="1.0" encoding="UTF-8"?>



<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>HospitalWebApp</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Servlet Mappings - Optional if using @WebServlet -->
    <servlet>
        <servlet-name>AddPatient</servlet-name>
        <servlet-class>com.servlet.AddPatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddPatient</servlet-name>
        <url-pattern>/addPatient</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>DisplayPatients</servlet-name>
        <servlet-class>com.servlet.DisplayPatientsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DisplayPatients</servlet-name>
        <url-pattern>/displayPatients</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>UpdatePatient</servlet-name>
        <servlet-class>com.servlet.UpdatePatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdatePatient</servlet-name>
        <url-pattern>/updatePatient</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>DeletePatient</servlet-name>
        <servlet-class>com.servlet.DeletePatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeletePatient</servlet-name>
        <url-pattern>/deletePatient</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>Report</servlet-name>
        <servlet-class>com.servlet.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Report</servlet-name>
        <url-pattern>/generateReport</url-pattern>
    </servlet-mapping>
    
</web-app>